{
  "name": "qred-api-contract",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "openapi:bundle": "mkdir -p openapi/dist && redocly bundle openapi/qred-api.yaml --output openapi/dist/openapi.bundle.yaml",
    "openapi:types": "npx openapi-typescript openapi/dist/openapi.bundle.yaml -o src/generated/openapi.ts",
    "openapi:all": "npm run openapi:bundle && npm run openapi:types",
    "mock": "npm run openapi:bundle && prism mock openapi/dist/openapi.bundle.yaml --host 0.0.0.0 --port 4010",
    "mock:dynamic": "npm run openapi:bundle && prism mock openapi/dist/openapi.bundle.yaml --dynamic --host 0.0.0.0 --port 4010",
    "docs:swagger": "npm run openapi:bundle && npx swagger-ui-watcher openapi/dist/openapi.bundle.yaml --port 8080",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "predev": "npm run openapi:all",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts,js,json --exec tsx src/index.ts",
    "prebuild": "npm run openapi:all",
    "build": "tsc",
    "prestart": "npm run openapi:all",
    "start": "node dist/index.js",
    "db:setup": "tsx src/db/sequelize.ts --force --seed",
    "db:seed": "tsx src/db/seed/seed.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "pretest": "npm run openapi:all",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@redocly/cli": "^2.26.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.2",
    "supertest": "^7.2.2",
    "swagger-ui-watcher": "^2.1.14",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.3.2",
    "opossum": "^8.5.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  }
}
